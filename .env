# Configuration for the API and the client.
#
# This file is COMMITTED so the deployment can read it, which means everything
# in it is visible to anyone with access to the repository and stays in git
# history. Treat RESEARCH_TOKEN as public-ish and rotate it by changing the
# value here; if that stops being acceptable, move the secret lines into the
# host's own environment settings — the code reads process.env either way, and
# a real environment variable overrides this file.

# ── API server ───────────────────────────────────────────────
PORT=4000

# Browser origins allowed to call the API. The deployed site is same-origin,
# so it needs no entry here; these are for local development.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Researcher access ────────────────────────────────────────
# Required for /api/research/* — transcripts, snippets, export.
# Without it those endpoints return 503.
RESEARCH_TOKEN=ZY85TIxwbw5k-H4R2ZEldzeJq360TklR

# ── Accounts ─────────────────────────────────────────────────
# How long a login lasts before the token stops working.
AUTH_TOKEN_TTL_DAYS=30

# Guards POST /api/auth/bootstrap, which creates the first admin and is refused
# once any user exists. Unset, it falls back to RESEARCH_TOKEN above — which is
# why there has to be one: with neither set, whoever calls that route first on an
# empty database becomes the admin. GET /api/health warns while that is true.
# BOOTSTRAP_TOKEN=

# ── Consent ──────────────────────────────────────────────────
# Stored on every consent record. Bump this whenever the wording in
# src/components/Entry.jsx changes, so it is clear what each student agreed to.
CONSENT_VERSION=2026-07-29.placeholder

# ── Uploads ──────────────────────────────────────────────────
# 10 MB per file. Vercel Functions accept request bodies up to 100 MB.
MAX_UPLOAD_BYTES=10485760

# Where uploaded files land. Left unset on purpose: locally it defaults to
# server/.uploads, and on a serverless host to the instance temp directory.
# UPLOAD_DIR=

# ── Client ───────────────────────────────────────────────────
# Vite reads VITE_-prefixed keys from this file at build time. Empty means
# same-origin /api, which is what both local dev (via the Vite proxy) and the
# deployment use. Set it only to point the client at a different API host.
VITE_API_BASE=

# ── Database ─────────────────────────────────────────────────
# MONGODB_URI selects the MongoDB store; unset means in-memory.
#
# WARNING: the password below is committed and permanently in git history.
# Anyone with repository access has full read/write on this cluster, and
# rotating it means changing the Atlas password, not just this line. Kept here
# because this is the production database and the deployment reads this file.
# The safer arrangement is Vercel → Project → Settings → Environment Variables,
# which overrides this file; move it there and blank this line when convenient.
MONGODB_URI=mongodb+srv://akartunacanberk_db_user:qOfIEuWegBpF8EyW@cluster0.ysha7l7.mongodb.net/?appName=Cluster0

# The URI above names no database, so without this the driver would use `test`.
MONGODB_DB=feedback_evaluator

# ── Uploads: DigitalOcean Spaces ─────────────────────────────
# Photos of working and whiteboard exports. Unset SPACES_KEY/SPACES_SECRET and
# uploads go to local disk instead, which is fine for development and is data
# loss on a serverless host — see server/README.md.
#
# The credentials are a credential: they go in .env.local or the host's
# environment settings, NEVER here. Generate them at
# DigitalOcean -> API -> Spaces Keys.
#
#   SPACES_KEY=...
#   SPACES_SECRET=...
#
# These three are just names, so they can live here:
SPACES_BUCKET=dropshot
SPACES_REGION=sfo3
SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com

# How long a signed read URL stays valid, in seconds. Objects are private, so
# every read is signed on demand.
SPACES_URL_TTL=300
