# Configuration for the API and the client.
#
# This file is COMMITTED so the deployment can read it, which means everything
# in it is visible to anyone with access to the repository and stays in git
# history. Treat RESEARCH_TOKEN as public-ish and rotate it by changing the
# value here; if that stops being acceptable, move the secret lines into the
# host's own environment settings — the code reads process.env either way, and
# a real environment variable overrides this file.

# ── API server ───────────────────────────────────────────────
PORT=4000

# Browser origins allowed to call the API. The deployed site is same-origin,
# so it needs no entry here; these are for local development.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Researcher access ────────────────────────────────────────
# Required for /api/research/* — transcripts, snippets, export.
# Without it those endpoints return 503.
RESEARCH_TOKEN=ZY85TIxwbw5k-H4R2ZEldzeJq360TklR

# ── Consent ──────────────────────────────────────────────────
# Stored on every consent record. Bump this whenever the wording in
# src/components/Entry.jsx changes, so it is clear what each student agreed to.
CONSENT_VERSION=2026-07-29.placeholder

# ── Uploads ──────────────────────────────────────────────────
# 10 MB per file. Vercel Functions accept request bodies up to 100 MB.
MAX_UPLOAD_BYTES=10485760

# Where uploaded files land. Left unset on purpose: locally it defaults to
# server/.uploads, and on a serverless host to the instance temp directory.
# UPLOAD_DIR=

# ── Client ───────────────────────────────────────────────────
# Vite reads VITE_-prefixed keys from this file at build time. Empty means
# same-origin /api, which is what both local dev (via the Vite proxy) and the
# deployment use. Set it only to point the client at a different API host.
VITE_API_BASE=

# ── Database (not read yet) ──────────────────────────────────
# The store is in-memory until server/store/mongo.js exists. When it does,
# putting a URI here means database credentials in git — that is the point at
# which this file should stop holding secrets.
# MONGODB_URI=
