# Configuration for the API and the client — DEVELOPMENT ONLY.
#
# This file and .env.local are merged for local development (see
# server/config.js: .env.local wins, real environment variables win over both).
# The deployment reads NEITHER file: in production every value comes from
# Vercel → Project → Settings → Environment Variables.
#
# This file is committed, so everything in it is visible to anyone with access
# to the repository and stays in git history. Credentials belong in .env.local
# (gitignored) locally and in Vercel's settings once deployed.

# ── API server ───────────────────────────────────────────────
PORT=4000

# Browser origins allowed to call the API. The deployed site is same-origin,
# so it needs no entry here; these are for local development.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ── Researcher access ────────────────────────────────────────
# Required for /api/research/* — transcripts, snippets, export.
# Without it those endpoints return 503.
RESEARCH_TOKEN=ZY85TIxwbw5k-H4R2ZEldzeJq360TklR

# ── Accounts ─────────────────────────────────────────────────
# How long a login lasts before the token stops working.
AUTH_TOKEN_TTL_DAYS=30

# Guards POST /api/auth/bootstrap, which creates the first admin and is refused
# once any user exists. Unset, it falls back to RESEARCH_TOKEN above — which is
# why there has to be one: with neither set, whoever calls that route first on an
# empty database becomes the admin. GET /api/health warns while that is true.
# BOOTSTRAP_TOKEN=

# ── Consent ──────────────────────────────────────────────────
# Stored on every consent record. Bump this whenever the wording in
# src/components/Entry.jsx changes, so it is clear what each student agreed to.
CONSENT_VERSION=2026-07-29.placeholder

# ── Uploads ──────────────────────────────────────────────────
# 10 MB per file. Vercel Functions accept request bodies up to 100 MB.
MAX_UPLOAD_BYTES=10485760

# Only the disk fallback, and only when Spaces is unconfigured. Left unset on
# purpose: it defaults to the system temp directory, never inside the repo.
# UPLOAD_DIR=

# ── Client ───────────────────────────────────────────────────
# Vite reads VITE_-prefixed keys from this file at build time. Empty means
# same-origin /api, which is what both local dev (via the Vite proxy) and the
# deployment use. Set it only to point the client at a different API host.
VITE_API_BASE=

# ── Database ─────────────────────────────────────────────────
# MONGODB_URI selects the MongoDB store; unset means in-memory.
#
# WARNING: the password below is committed and permanently in git history.
# Anyone with repository access has full read/write on this cluster, and
# rotating it means changing the Atlas password, not just this line.
#
# The deployment no longer reads this file — production MUST have MONGODB_URI
# set in Vercel → Project → Settings → Environment Variables, or it falls back
# to the in-memory store. This line now only serves local development; the same
# value already lives in .env.local, so blank it here when convenient.
MONGODB_URI=mongodb+srv://akartunacanberk_db_user:qOfIEuWegBpF8EyW@cluster0.ysha7l7.mongodb.net/?appName=Cluster0

# The URI above names no database, so without this the driver would use test.
#
# Deliberately still the old name. The app was renamed to Dropshot after this
# database already held accounts, and renaming a database is a migration, not an
# edit — changing this line alone would point a running deployment at an empty
# one. A fresh install with this unset gets dropshot (see store/mongo.js).
MONGODB_DB=feedback_evaluator

# ── Uploads: DigitalOcean Spaces ─────────────────────────────
# Photos of working, whiteboard exports and uploaded questions. Unset
# SPACES_KEY/SPACES_SECRET and uploads fall back to the system temp directory,
# which is fine for tests and is data loss anywhere real — see server/README.md.
# Nothing is ever written inside the repository.
#
# The key and secret below serve LOCAL DEVELOPMENT ONLY now — the deployment
# no longer reads this file, so production MUST have SPACES_KEY/SPACES_SECRET
# set in Vercel → Project → Settings → Environment Variables, or uploads fall
# back to the instance's temp directory and are lost on recycle.
#
# Both values are readable by anyone with repository access and stay in git
# history for good — rotating them means generating a new pair at
# DigitalOcean -> API -> Spaces Keys, not editing these lines. Move them to
# .env.local and blank them here when convenient.
#
# No inline comments on these two: an unquoted value runs to the first ` #', so
# a trailing label would be parsed as part of the credential.
SPACES_KEY=DO00BT94X4BWEUDXKPZB
SPACES_SECRET=u8pmwqyo1579PkRbMpGBuGeG+gJxQv9SHdByry1KEf8
#
# These are just names, so they can live here. The bucket is shared with
# another application; everything this one writes goes under SPACES_PREFIX and
# nothing outside it is ever touched.
SPACES_BUCKET=mezqr-bucket
SPACES_PREFIX=dropshot
SPACES_REGION=sfo3
SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com

# How long a signed read URL stays valid, in seconds. Objects are private, so
# every read is signed on demand.
SPACES_URL_TTL=300

# ── The tutor's model: OpenAI ────────────────────────────────
# OPENAI_API_KEY is deliberately NOT here. It lives in .env.local, which is
# gitignored — so the key has never been committed and is not in git history,
# which is the one property the Mongo and Spaces credentials above have already
# lost. The merge of .env.local over this file is how local development gets it.
#
# The deployment reads neither file: **production has no key until one is set
# in Vercel → Project → Settings → Environment Variables**, and until then the
# deployed tutor answers from the scripted lines with nothing on screen to say
# so. GET /api/health reports which of the two is answering — check it on the
# deployment after a change — and npm run check:openai calls the model for
# real. New key: https://platform.openai.com/api-keys
#
# A reasoning model: markedly better tutoring than gpt-4o-mini (which is what
# ran here before) and it reads the question images well, while staying cheap
# enough for a classroom. `gpt-5` is the premium step up if replies still feel
# thin. The bare name is an alias that moves to the newest snapshot; pin a
# dated one while a study is running so the replies stay comparable.
#
# server/config.js derives the family-dependent knobs from the name: a
# reasoning model (o-series, gpt-5-*) gets no temperature and a default
# reasoning effort, a non-reasoning model the reverse — so switching this line
# alone is safe either way. The explicit values below just make the local
# setup visible.
OPENAI_MODEL=gpt-5-mini


# A student is watching a typing indicator, so the timeout is short.
OPENAI_TIMEOUT_MS=20000

# Empty on purpose: reasoning models reject any temperature but the default.
# Set a number here only when running a non-reasoning model (e.g. 0.6 for
# gpt-4o-mini).
OPENAI_TEMPERATURE=

# NOT the length of the reply — the prompt caps that at 120 words. On a
# reasoning model (o-series, gpt-5-*) this budget covers the model's hidden
# reasoning as well, which is spent first, so lowering it does not save money,
# it truncates replies — and a truncated reply is treated as a failure, which
# sends the scripted fallback line. 4000 leaves comfortable room for low-effort
# reasoning over a question image plus the reply itself.
OPENAI_MAX_OUTPUT_TOKENS=4000

# How hard the reasoning model thinks before replying: minimal, low, medium or
# high. `low` is the sweet spot for a 120-word tutor turn — every reasoning
# token is billed, and a student is waiting. Non-reasoning models reject this
# field; empty it out when pointing OPENAI_MODEL at one of those.
OPENAI_REASONING_EFFORT=low