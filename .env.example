# Template for .env. Copy it and fill in the values:
#
#   cp .env.example .env
#
# Generate a research token with:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"

PORT=4000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Required for /api/research/* — without it those endpoints return 503.
RESEARCH_TOKEN=

CONSENT_VERSION=2026-07-29.placeholder
MAX_UPLOAD_BYTES=10485760
# UPLOAD_DIR=

# Empty means same-origin /api.
VITE_API_BASE=

# Not read until server/store/mongo.js exists.
# MONGODB_URI=
