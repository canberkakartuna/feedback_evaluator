# Template for .env — committed config, no secrets. Copy it and fill it in:
#
#   cp .env.example .env
#
# Generate a research token with:
#   node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
#
# Credentials go in .env.local instead (gitignored, and it overrides .env):
#
#   MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/

PORT=4000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Required for /api/research/* — without it those endpoints return 503.
RESEARCH_TOKEN=

# Accounts. AUTH_TOKEN_TTL_DAYS is how long a login lasts. BOOTSTRAP_TOKEN
# guards POST /api/auth/bootstrap (the first admin) and falls back to
# RESEARCH_TOKEN when unset — set one of the two before deploying, or that route
# is open to whoever calls it first on an empty database.
AUTH_TOKEN_TTL_DAYS=30
# BOOTSTRAP_TOKEN=

CONSENT_VERSION=2026-07-29.placeholder
MAX_UPLOAD_BYTES=10485760
# UPLOAD_DIR=

# Empty means same-origin /api.
VITE_API_BASE=

# Unset MONGODB_URI (see the header) means the in-memory store. This is just a
# name, so it can live here.
MONGODB_DB=dropshot

# ── Uploads: DigitalOcean Spaces ─────────────────────────────
# Photos of working, whiteboard exports and uploaded questions. Unset
# SPACES_KEY/SPACES_SECRET and uploads fall back to the system temp directory,
# which is fine for tests and is data loss anywhere real — see server/README.md.
# Nothing is ever written inside the repository.
#
# The credentials are a credential: they go in .env.local or the host's
# environment settings, NEVER here. Generate them at
# DigitalOcean -> API -> Spaces Keys.
#
#   SPACES_KEY=...
#   SPACES_SECRET=...
#
# These are just names, so they can live here. The bucket is shared with
# another application; everything this one writes goes under SPACES_PREFIX and
# nothing outside it is ever touched.
SPACES_BUCKET=mezqr-bucket
SPACES_PREFIX=dropshot
SPACES_REGION=sfo3
SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com

# How long a signed read URL stays valid, in seconds. Objects are private, so
# every read is signed on demand.
SPACES_URL_TTL=300

# ── The tutor's model: OpenAI ────────────────────────────────
# The key is a credential: .env.local, or the host's environment settings once
# deployed — NEVER here. Get one at https://platform.openai.com/api-keys.
#
#   OPENAI_API_KEY=...
#
# Leave it unset and the tutor answers from the scripted lines in
# shared/tutor-scripts.js instead of a model. Everything still works, the chat is
# just canned — `GET /api/health` warns while that is the case, and
# `npm run check:openai` calls the model for real once a key is in place.
#
# These are knobs, not secrets. OPENAI_MAX_OUTPUT_TOKENS is not the length of a
# reply — the prompt caps that at 120 words — on a reasoning model it also has
# to cover the hidden reasoning, which is billed to the same allowance and
# spent first. OPENAI_REASONING_EFFORT is for reasoning models only, and
# OPENAI_TEMPERATURE for non-reasoning models only; server/config.js derives
# the right default for whichever family OPENAI_MODEL names, so set them only
# to override. See server/lib/openai.js.
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_MS=20000
OPENAI_MAX_OUTPUT_TOKENS=4000
# OPENAI_TEMPERATURE=0.6
# OPENAI_REASONING_EFFORT=low
